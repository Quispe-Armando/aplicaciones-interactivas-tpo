@base = http://localhost:3000

# Requests de prueba para TODOS los endpoints de la API. Se usan con la extension "REST Client" de VS Code
# (o se copian a Thunder Client / Postman). Probalas de arriba hacia abajo.
#
# Punto de partida: base vacia (solo migraciones) o con el seed (npm run seed).
#   - Con el seed, los registros de Carla y Pedro de abajo responden 409 (ya existen): es lo esperado,
#     y los logins siguen funcionando (contraseña clave1234). Las inmobiliarias quedan con id 1 (Carla) y 2 (Pedro).
#   - Cada seccion crea sus propios datos, asi que se puede correr sobre el seed sin romper nada.
#   - La seccion "Inmobiliaria: perfil y ABM" BORRA la inmobiliaria de Pedro (id 2). Su token sigue sirviendo para
#     probar los 403 de las secciones siguientes, pero ya no tiene inmobiliaria propia. Para recuperarla: npm run seed.

# ─────────────────────────────────────────────
# Health
# ─────────────────────────────────────────────

### Debe responder 200 { "status": "ok" }
GET {{base}}/health

# ─────────────────────────────────────────────
# Autenticacion del vendedor
# ─────────────────────────────────────────────

### Registro: crea el Seller y su Agency en el mismo paso -> 201
POST {{base}}/auth/register
Content-Type: application/json

{
  "fullName": "Carla Oeste",
  "email": "carla@demo.com",
  "password": "clave1234",
  "phone": "11-5555-1111",
  "agency": { "name": "Oeste Propiedades", "contactPhone": "11-4000-3333" }
}

### Mismo email otra vez -> 409
POST {{base}}/auth/register
Content-Type: application/json

{
  "fullName": "Otra Persona",
  "email": "carla@demo.com",
  "password": "clave1234",
  "agency": { "name": "Otra Inmobiliaria", "contactPhone": "11-4000-4444" }
}

### Mismo nombre de fantasia con otro email -> 409
POST {{base}}/auth/register
Content-Type: application/json

{
  "fullName": "Otra Persona",
  "email": "otra@demo.com",
  "password": "clave1234",
  "agency": { "name": "Oeste Propiedades", "contactPhone": "11-4000-4444" }
}

### Body invalido (nombre vacio, email mal escrito, password corta, sin inmobiliaria) -> 400 con el campo que fallo
POST {{base}}/auth/register
Content-Type: application/json

{
  "fullName": "",
  "email": "esto-no-es-un-email",
  "password": "123"
}

### Login correcto -> 200 { token, seller, agency }
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "carla@demo.com", "password": "clave1234" }

### Password incorrecta -> 401
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "carla@demo.com", "password": "otra-clave" }

### Email que no existe -> 401 (mismo mensaje que arriba)
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "nadie@demo.com", "password": "clave1234" }

### Quien soy, con token -> 200 { seller, agency }
GET {{base}}/auth/me
Authorization: Bearer {{login.response.body.token}}

### Sin token -> 401
GET {{base}}/auth/me

### Token inventado -> 401
GET {{base}}/auth/me
Authorization: Bearer esto.no.es-un-token

# ─────────────────────────────────────────────
# Inmobiliaria: perfil y ABM
# (Correr primero el registro y el login de arriba. Reemplazar el 1 por el id de tu inmobiliaria.)
# ─────────────────────────────────────────────

### Perfil publico, sin token -> 200 (sin datos del vendedor: ni email del vendedor ni password)
GET {{base}}/agencies/1

### Inmobiliaria inexistente -> 404
GET {{base}}/agencies/9999

### Id invalido -> 400
GET {{base}}/agencies/abc

### Editar el perfil siendo el dueño (PUT reemplaza todo: se mandan todos los campos) -> 200
PUT {{base}}/agencies/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Oeste Propiedades",
  "description": "Inmobiliaria familiar con 20 años en zona oeste.",
  "logoUrl": "https://example.com/logo.png",
  "contactPhone": "11-4000-3333",
  "contactEmail": "contacto@oeste.com",
  "officeAddress": "Av. Rivadavia 1234, Ramos Mejía"
}

### Body invalido (nombre vacio, email mal escrito) -> 400 con el campo que fallo
PUT {{base}}/agencies/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "name": "", "description": "x", "contactPhone": "11-4000-3333", "contactEmail": "no-es-email" }

### Editar sin token -> 401
PUT {{base}}/agencies/1
Content-Type: application/json

{ "name": "Oeste Propiedades", "description": "x", "contactPhone": "1", "contactEmail": "a@b.com" }

### Propiedades publicadas de la inmobiliaria (publico, paginado) -> 200 { items, page, limit, total }
GET {{base}}/agencies/1/properties?page=1&limit=10

### Inmobiliaria inexistente -> 404
GET {{base}}/agencies/9999/properties

### Para probar el 403: registrar una SEGUNDA inmobiliaria, loguearse con ella y editar/borrar la 1
POST {{base}}/auth/register
Content-Type: application/json

{
  "fullName": "Pedro Sur",
  "email": "pedro@demo.com",
  "password": "clave1234",
  "agency": { "name": "Sur Inmuebles", "contactPhone": "11-4000-5555" }
}

###
# @name loginPedro
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "pedro@demo.com", "password": "clave1234" }

### Pedro intenta editar la inmobiliaria 1 -> 403
PUT {{base}}/agencies/1
Authorization: Bearer {{loginPedro.response.body.token}}
Content-Type: application/json

{ "name": "Hackeada", "description": "x", "contactPhone": "1", "contactEmail": "a@b.com" }

### Pedro intenta borrar la inmobiliaria 1 -> 403
DELETE {{base}}/agencies/1
Authorization: Bearer {{loginPedro.response.body.token}}

### Pedro edita con el nombre de otra inmobiliaria (la suya es la 2) -> 409
PUT {{base}}/agencies/2
Authorization: Bearer {{loginPedro.response.body.token}}
Content-Type: application/json

{ "name": "Oeste Propiedades", "description": "x", "contactPhone": "1", "contactEmail": "a@b.com" }

### Pedro elimina SU inmobiliaria (sin propiedades publicadas/reservadas) -> 204 sin body
# Despues, /auth/me con su token da 401 porque la cuenta ya no existe.
DELETE {{base}}/agencies/2
Authorization: Bearer {{loginPedro.response.body.token}}

### Con la cuenta borrada, el token ya no sirve -> 401
GET {{base}}/auth/me
Authorization: Bearer {{loginPedro.response.body.token}}

### El caso 409 de borrar con propiedades publicadas se prueba mas abajo, en la seccion de Propiedades.

# ─────────────────────────────────────────────
# Propiedades: ABM y busqueda
# Usar el token de Carla ("login" de arriba). Si ya borraste su inmobiliaria en la seccion anterior,
# volve a correr el registro y el login de Carla.
# ─────────────────────────────────────────────

### Crear un departamento en alquiler -> 201, status DRAFT (aunque mandes otro estado, se ignora)
# @name prop1
POST {{base}}/properties
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Depto 2 amb con vista",
  "description": "Luminoso, a una cuadra del subte.",
  "type": "APARTMENT",
  "operation": "RENT",
  "price": 400,
  "currency": "USD",
  "address": "Av. Corrientes 1234",
  "area": "Centro",
  "coveredAreaM2": 40,
  "totalAreaM2": 45,
  "rooms": 2,
  "bedrooms": 1,
  "bathrooms": 1,
  "ageYears": 10,
  "tags": ["Pileta", "balcón"],
  "images": [
    { "url": "https://example.com/depto-1.jpg", "isCover": true },
    { "url": "https://example.com/depto-2.jpg", "isCover": false }
  ],
  "status": "PUBLISHED"
}

