DELETE {{base}}/properties/{{prop2.response.body.id}}
Authorization: Bearer {{loginPedro.response.body.token}}

# ═════════════════════════════════════════════
# PAUSA: para seguir hay que PUBLICAR las propiedades. Todavia no hay endpoint de estados (Tarea 6),
# asi que en pgAdmin (Query Tool sobre tpo_inmobiliario) corre back/dev-sql/publicar-borradores.sql
# ═════════════════════════════════════════════

### Listado publico, sin filtros -> 200, las publicadas (la mas nueva primero), con total/page/limit
GET {{base}}/properties

### Detalle publico, ahora si -> 200 con galeria e inmobiliaria (sin datos del vendedor)
GET {{base}}/properties/{{prop1.response.body.id}}

### Filtro por tipo -> solo la casa
GET {{base}}/properties?type=HOUSE

### Tipo + operacion -> solo departamentos en alquiler
GET {{base}}/properties?type=APARTMENT&operation=RENT

### Rango de precio (en USD) -> solo la casa
GET {{base}}/properties?currency=USD&minPrice=100000&maxPrice=200000

### Zona (parcial, sin importar mayusculas) -> la casa
GET {{base}}/properties?area=osten

### Ambientes exactos -> el depto
GET {{base}}/properties?rooms=2

### Amenities: tiene que tener todas -> solo la casa
GET {{base}}/properties?amenities=pileta,cochera

### Amenities: pileta la tienen el depto y la casa
GET {{base}}/properties?amenities=pileta

### Texto libre en titulo o descripcion -> la casa (por "parrilla")
GET {{base}}/properties?q=parrilla

### Orden por precio ascendente
GET {{base}}/properties?sort=price&order=asc

### Orden por superficie total descendente
GET {{base}}/properties?sort=totalArea&order=desc

### Paginado de a 1 -> items con 1 elemento, total con la cantidad real
GET {{base}}/properties?page=2&limit=1

### Combinado: casas en venta con pileta, mas baratas primero
GET {{base}}/properties?type=HOUSE&operation=SALE&amenities=pileta&sort=price&order=asc

### Filtro invalido -> 400
GET {{base}}/properties?type=CASTILLO

### Ordenar por un campo no permitido -> 400
GET {{base}}/properties?sort=password

### Sin resultados -> 200 con items vacio y total 0
GET {{base}}/properties?q=zzzzzz

### Propiedades publicadas de la inmobiliaria 1 (Tarea 4), ahora con datos
GET {{base}}/agencies/1/properties

### Eliminar una publicada -> 409 (solo se eliminan borradores)
DELETE {{base}}/properties/{{prop2.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

### Borrar la inmobiliaria con propiedades publicadas -> 409 (el caso pendiente de la Tarea 4)
DELETE {{base}}/agencies/1
Authorization: Bearer {{login.response.body.token}}

# ═════════════════════════════════════════════
# Para probar el bloqueo de edicion por estado: en pgAdmin correr back/dev-sql/marcar-vendida.sql
# (marca la propiedad 1 como SOLD) y despues probar el request de abajo.
# ═════════════════════════════════════════════

### Editar una propiedad vendida -> 409
PUT {{base}}/properties/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "x", "description": "x", "type": "APARTMENT", "operation": "RENT", "price": 1, "currency": "USD",
  "address": "x", "area": "x", "totalAreaM2": 45,
  "images": [{ "url": "https://example.com/a.jpg", "isCover": true }]
}

# ─────────────────────────────────────────────
# Estados de la propiedad (maquina de estados) e historial
# Ahora las propiedades se publican por la API: ya no hace falta dev-sql/publicar-borradores.sql.
# ─────────────────────────────────────────────

### Crear un alquiler para probar los estados -> 201 DRAFT (y el historial arranca con null -> DRAFT)
# @name t6
POST {{base}}/properties
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "PH al frente en alquiler",
  "description": "Para probar los estados.",
  "type": "APARTMENT",
  "operation": "RENT",
  "price": 600,
  "currency": "USD",
  "address": "Honduras 4000",
  "area": "Palermo",
  "totalAreaM2": 60,
  "images": [{ "url": "https://example.com/ph.jpg", "isCover": true }]
}

### Borrador -> Vendida: transicion invalida -> 400 con las opciones permitidas
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "SOLD" }

### Borrador -> Cancelada: invalida (un borrador se elimina, no se cancela) -> 400
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "CANCELLED" }

### Estado que no existe -> 400
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "VOLADA" }

### Sin token -> 401
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Content-Type: application/json

{ "status": "PUBLISHED" }

### De otro vendedor (Pedro) -> 403 (requiere el login de Pedro; si lo borraste, registralo de nuevo)
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{loginPedro.response.body.token}}
Content-Type: application/json

{ "status": "PUBLISHED" }

### Propiedad que no existe -> 404
PATCH {{base}}/properties/9999/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "PUBLISHED" }

### Borrador -> Publicada: OK -> 200, publishedAt con la fecha de ahora
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "PUBLISHED" }

### Ahora aparece en el listado publico y en su detalle
GET {{base}}/properties/{{t6.response.body.id}}

### Publicada -> Publicada: no es un cambio -> 400
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "PUBLISHED" }

### Publicada -> Pausada -> 200 (deja de aparecer en el listado publico)
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "PAUSED" }

### Pausada -> Publicada -> 200 (publishedAt NO cambia: sigue siendo la de la primera vez)
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "PUBLISHED" }

### Publicada -> Reservada -> 200
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "RESERVED" }

### Reservada -> Vendida, pero es un ALQUILER -> 400 (le corresponde RENTED)
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "SOLD" }

### Reservada -> Alquilada -> 200
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "RENTED" }

### Alquilada es un estado final: no se sale -> 400
PATCH {{base}}/properties/{{t6.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "PUBLISHED" }

### Y ya no se edita -> 409 (regla de la Tarea 5)
PUT {{base}}/properties/{{t6.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "x", "description": "x", "type": "APARTMENT", "operation": "RENT", "price": 1, "currency": "USD",
  "address": "x", "area": "x", "totalAreaM2": 45,
  "images": [{ "url": "https://example.com/a.jpg", "isCover": true }]
}

### Historial completo, del mas viejo al mas nuevo -> 200
# Esperado: null->DRAFT, DRAFT->PUBLISHED, PUBLISHED->PAUSED, PAUSED->PUBLISHED, PUBLISHED->RESERVED, RESERVED->RENTED
# (los intentos invalidos de arriba NO dejan registro)
GET {{base}}/properties/{{t6.response.body.id}}/status-history
Authorization: Bearer {{login.response.body.token}}

### Historial de otro vendedor -> 403
GET {{base}}/properties/{{t6.response.body.id}}/status-history
Authorization: Bearer {{loginPedro.response.body.token}}

### Historial sin token -> 401
GET {{base}}/properties/{{t6.response.body.id}}/status-history

### Cancelar desde Pausada: crear una venta, publicarla, pausarla y cancelarla
# @name t6b
POST {{base}}/properties
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Casa para cancelar",
  "description": "Para probar la cancelacion.",
  "type": "HOUSE",
  "operation": "SALE",
  "price": 90000,
  "currency": "USD",
  "address": "Calle 1 100",
  "area": "Tigre",
  "totalAreaM2": 300,
  "images": [{ "url": "https://example.com/c.jpg", "isCover": true }]
}

###
PATCH {{base}}/properties/{{t6b.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "PUBLISHED" }

###
PATCH {{base}}/properties/{{t6b.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "PAUSED" }

### Pausada -> Cancelada -> 200
PATCH {{base}}/properties/{{t6b.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "CANCELLED" }

### Cancelada -> cualquier otra -> 400 (estado final)
PATCH {{base}}/properties/{{t6b.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "PUBLISHED" }

### Con la propiedad en estado final, el 409 de la Tarea 4 ya no aplica: las que quedan PUBLISHED/RESERVED siguen bloqueando el borrado de la inmobiliaria.
### El caso "cancelar con visita Confirmada -> 409" se prueba en la Tarea 8.

# ─────────────────────────────────────────────
# Consultas (comentarios) sobre una propiedad
# Se usa la propiedad "t6" de la seccion anterior: quedo ALQUILADA, y una propiedad alquilada igual admite comentarios.
# ─────────────────────────────────────────────

### Un interesado comenta, sin token -> 201 { id, authorName, content, reply: null, createdAt }
# @name c1
POST {{base}}/properties/{{t6.response.body.id}}/comments
Content-Type: application/json

{ "authorName": "Ana", "content": "¿Admite mascotas?" }

### Otro comentario -> 201
# @name c2
POST {{base}}/properties/{{t6.response.body.id}}/comments
Content-Type: application/json

{ "authorName": "Luis", "content": "¿Las expensas estan incluidas?" }

