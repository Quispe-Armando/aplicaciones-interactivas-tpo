# ─────────────────────────────────────────────
# Solicitudes de visita
# La fecha va en ISO 8601 CON zona horaria (el front puede mandar new Date(...).toISOString()).
# Cambia 2027-03-15 por una fecha futura si ya paso.
# ─────────────────────────────────────────────

### Preparacion: una propiedad publicada para pedir visitas
# @name t8
POST {{base}}/properties
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Casa para visitas",
  "description": "Para probar las solicitudes de visita.",
  "type": "HOUSE",
  "operation": "SALE",
  "price": 150000,
  "currency": "USD",
  "address": "Calle 7 700",
  "area": "Pilar",
  "totalAreaM2": 350,
  "images": [{ "url": "https://example.com/v.jpg", "isCover": true }]
}

###
PATCH {{base}}/properties/{{t8.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "status": "PUBLISHED" }

